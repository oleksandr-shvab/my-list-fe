{
  "permissions": {
    "allow": [
      "Bash(git merge-base *)",
      "Bash(git ls-tree *)",
      "Bash(npm view *)",
      "Bash(npm run build)",
      "Bash(npm run lint)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read -r f; npx prettier --ignore-unknown --write \"$f\"; } 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
